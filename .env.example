# ==============================================================================
# MinecraftAI Environment Configuration Example
# Copy this file to .env and configure for your local or production environment.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# Server Network Configuration (binds to 127.0.0.1 by default for local privacy)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# LLM / AI Engine Configuration
# Recommended: Ollama Cloud with 'ollama signin' (No API key required!)
# The 120-billion parameter model executes on Ollama Cloud; no large model weights are stored locally.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
# OLLAMA_NUM_CTX=16384
# OLLAMA_NUM_PREDICT=4096
# OLLAMA_API_KEY is NOT required when using 'ollama signin' through your local Ollama daemon.

# Optional: Direct Remote Ollama Cloud (only for server/container environments without local Ollama CLI):
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Optional External AI Provider (OpenAI)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Security & Rate Limiting Controls
MC_MAX_PROMPT_LENGTH=2000
MC_RATE_LIMIT_PER_MINUTE=30
MC_BURST_ALLOWANCE=10
MC_MAX_CONCURRENT_GENERATIONS=4
MC_MAX_ZIP_SIZE_MB=50
MC_MAX_ZIP_ENTRIES=500
MC_GENERATION_TIMEOUT_SECONDS=60.0
MC_ARTIFACT_RETENTION_SECONDS=3600

# CORS Allowed Origins / Production Domain
PUBLIC_ORIGIN=https://your-domain.example
MC_ALLOWED_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging & Privacy
LOG_LEVEL=INFO
MC_ANONYMIZE_LOGS=true
MC_MASK_PROMPTS_IN_LOGS=false
