# ==============================================================================
# MinecraftAI Environment Configuration Example
# Copy this file to .env and configure for your local or production environment.
# DO NOT commit real secrets or production .env files to version control.
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# LLM / AI Engine Configuration
# Intended Production Provider: Ollama Cloud
LLM_PROVIDER=ollama
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Optional Local Ollama Development Configuration (uncomment to use local daemon):
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Optional External API Keys (only if using external providers)
# OPENAI_API_KEY=your_openai_api_key_here

# Security & Rate Limiting Controls
MC_MAX_PROMPT_LENGTH=2000
MC_RATE_LIMIT_PER_MINUTE=30
MC_BURST_ALLOWANCE=10
MC_MAX_CONCURRENT_GENERATIONS=4
MC_MAX_ZIP_SIZE_MB=50
MC_MAX_ZIP_ENTRIES=500
MC_GENERATION_TIMEOUT_SECONDS=60.0

# CORS Allowed Origins (Comma-separated list or JSON array for production)
# In development, localhost is permitted. In production, specify your exact domain.
MC_ALLOWED_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Logging & Privacy
LOG_LEVEL=INFO
MC_ANONYMIZE_LOGS=true
MC_MASK_PROMPTS_IN_LOGS=false
